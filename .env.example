# Examples only. Configure real values in Render's secret environment fields.
APP_ENV=cloud
DATABASE_URL=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DATABASE?sslmode=require
# Generate a private random secret (at least 20 characters); no default supplied.
ADMIN_PASSWORD=
WEB_BUILD_PATH=/app/web
PORT=10000
# Comma-separated ingress CIDRs, confirmed for your deployment. No wildcard.
TRUSTED_PROXY_CIDRS=
